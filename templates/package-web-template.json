{
  "name": "@expreva/php-wasm-web",
  "version": "3.0.14",
  "description": "PHP WebAssembly for the web - Published as individual versions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expreva/php-wasm.git"
  },
  "homepage": "https://github.com/expreva/php-wasm",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json",
    "./README.md": "./README.md"
  },
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=20.18.3",
    "npm": ">=10.1.0"
  },
  "dependencies": {
    "wasm-feature-detect": "1.8.0",
    "ws": "8.18.1",
    "@php-wasm/util": "3.0.14",
    "@php-wasm/universal": "3.0.14",
    "@php-wasm/logger": "3.0.14",
    "@php-wasm/fs-journal": "3.0.14",
    "@php-wasm/web-service-worker": "3.0.14"
  }
}